# ============================================================
# Root .gitignore — Dependencies, Secrets, Builds, & Data
# ============================================================

# Dependencies
node_modules/
*/node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment variables & secrets (Root and ALL subfolders)
.env
.env.*
.env*
**/.env
**/.env.*
**/.env*
*.env

# Production build outputs
dist/
dist-ssr/
build/
**/dist/
**/build/

# Runtime / Local Database Files
data/
backend/data/
**/data/
*.sqlite
*.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
