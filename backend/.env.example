# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173
MONGO_URL=mongodb://localhost:27017/legal_rag

# JWT Secret
JWT_SECRET=your_long_random_jwt_secret_here

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password

# Google OAuth 2.0 (Google Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# reCAPTCHA v3
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key
RECAPTCHA_SCORE_THRESHOLD=0.5

# Contact Form & Account Deactivation Settings
CONTACT_RECEIVER_EMAIL=admin@yourdomain.com
REACTIVATION_TOKEN_EXPIRY_DAYS=30
